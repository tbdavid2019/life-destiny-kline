# ==============================================================================
# Server-side Environment Variables (Set in Vercel Dashboard ONLY — NEVER commit secrets!)
# ==============================================================================
# Set to "true" to enable the free LLM proxy, or "false" to turn it off immediately
FREE_LLM_ENABLED=true

# Secret API key for upstream OpenAI-compatible gateway (keep strictly in Vercel Secrets)
FREE_LLM_API_KEY=sk-your-secret-key-here

# Upstream OpenAI-compatible base URL and default model
FREE_LLM_BASE_URL=https://llm.aiurl.tw/v1
FREE_LLM_MODEL=group/talk

# Optional comma-separated CORS origins (defaults to production Vercel + GitHub Pages)
# FREE_LLM_ALLOWED_ORIGINS=https://life-destiny-kline.vercel.app,https://tbdavid2019.github.io

# ==============================================================================
# Optional Build-time Frontend Variables (Public — NEVER put secret keys in VITE_*)
# ==============================================================================
# Set to "false" at build time to hide the free mode UI completely
# VITE_FREE_LLM_ENABLED=true

# Override free LLM proxy endpoint (defaults to /api/free-llm on Vercel, or Vercel URL on GitHub Pages)
# VITE_FREE_LLM_ENDPOINT=/api/free-llm
